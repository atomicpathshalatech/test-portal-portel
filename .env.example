# Supabase Postgres connection string (Project Settings -> Database -> Connection String -> URI)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# Any random long string, used to sign login tokens
JWT_SECRET="change-this-to-a-long-random-string"

# For question image uploads (Supabase Storage)
# Project Settings -> API -> Project URL, and the "service_role" secret key
SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# Optional: only needed if Puppeteer's bundled Chromium download fails locally.
# Point this at your existing Chrome install instead.
# PUPPETEER_EXECUTABLE_PATH="C:\Program Files\Google\Chrome\Application\chrome.exe"

# For AI-assisted question solving/generation (Question Bank -> "Solve with AI" / "AI Generate")
# Free API key from https://aistudio.google.com/apikey — no credit card needed, doesn't expire.
# You can add MULTIPLE keys (comma-separated, no spaces) — if one hits its free-tier
# rate limit, the next one is used automatically.
GEMINI_API_KEYS="AIza...key1,AIza...key2,AIza...key3"
