generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                     String               @id @default(uuid())
  externalRefId          String?
  name                   String
  email                  String               @unique
  passwordHash           String
  role                   Role                 @default(STUDENT)
  createdAt              DateTime             @default(now())
  batch                  String?
  city                   String?
  institute              String?
  state                  String?
  subject                String?
  studentIdCode          String?              @unique
  mobile                 String?
  dateOfBirth            DateTime?
  gender                 String?
  photoUrl               String?
  course                 String?
  isActive               Boolean              @default(true)
  attempts               Attempt[]
  auditLogs              AuditLog[]
  bookmarks              Bookmark[]
  sessions               DeviceSession[]
  createdDpps            Dpp[]                @relation("DppCreatedBy")
  loginAttempts          LoginAttempt[]
  notifications          Notification[]
  passwordHistory        PasswordHistory[]
  passwordResetTokens    PasswordResetToken[]
  createdQuestions       Question[]           @relation("QuestionCreatedBy")
  publishedQuestions     Question[]           @relation("QuestionPublishedBy")
  reportsClaimed         QuestionReport[]     @relation("ReportClaimedBy")
  reportsFiled           QuestionReport[]     @relation("ReportFiledBy")
  questionVersionsEdited QuestionVersion[]    @relation("QuestionVersionEditedBy")
  createdTests           Test[]               @relation("TestCreatedBy")
  createdTestTemplates   TestTemplate[]       @relation("TestTemplateCreatedBy")
  createdModules         Module[]             @relation("ModuleCreatedBy")
  createdBrandProfiles   BrandProfile[]       @relation("BrandProfileCreatedBy")
}

model PasswordHistory {
  id           String   @id @default(uuid())
  userId       String
  passwordHash String
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model LoginAttempt {
  id        String   @id @default(uuid())
  email     String
  success   Boolean
  ipAddress String?
  userId    String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])
}

model TestSeries {
  id            String    @id @default(uuid())
  externalRefId String?
  name          String
  code          String    @unique
  description   String?
  targetBatch   String?
  startDate     DateTime?
  endDate       DateTime?
  createdAt     DateTime  @default(now())
  tags          String?
  thumbnailUrl  String?
  className     String?
  course        String?
  examType      String?
  visibility    String    @default("PRIVATE")
  tests         Test[]
}

model Test {
  id                     String       @id @default(uuid())
  externalRefId          String?
  testSeriesId           String
  name                   String
  code                   String       @unique
  languageMode           LanguageMode @default(BOTH)
  durationMin            Int
  openTime               DateTime
  closeTime              DateTime
  correctMarks           Float        @default(4)
  incorrectMarks         Float        @default(-1)
  createdAt              DateTime     @default(now())
  createdById            String?
  status                 TestStatus   @default(DRAFT)
  reminder15SentAt       DateTime?
  startNotifiedAt        DateTime?
  description            String?
  examType               String?
  instructions           String?
  negativeMarkingEnabled Boolean      @default(true)
  questionFormat         String       @default("OBJECTIVE")
  testType               String?
  archived               Boolean      @default(false)
  attempts               Attempt[]
  sections               Section[]
  createdBy              User?        @relation("TestCreatedBy", fields: [createdById], references: [id])
  testSeries             TestSeries   @relation(fields: [testSeriesId], references: [id])
}

model Section {
  id               String            @id @default(uuid())
  testId           String
  name             String
  order            Int               @default(0)
  marksPerQuestion Float?
  negativeMarks    Float?
  subject          String
  targetCount      Int               @default(0)
  test             Test              @relation(fields: [testId], references: [id])
  questions        SectionQuestion[]
}

model Question {
  id             String                @id @default(uuid())
  externalRefId  String?
  subject        String
  chapter        String?
  topic          String?
  type           QuestionType          @default(SINGLE_CORRECT)
  difficulty     Difficulty            @default(MEDIUM)
  createdAt      DateTime              @default(now())
  imageUrl       String?
  createdById    String?
  category       String?
  pyqSource      String?
  questionCode   String?               @unique
  solution       String?
  usageCount     Int                   @default(0)
  tags           String?
  isPublished    Boolean               @default(false)
  publishedAt    DateTime?
  publishedById  String?
  subTopic       String?
  attemptAnswers AttemptAnswer[]
  bookmarks      Bookmark[]
  dppLinks       DppQuestion[]
  createdBy      User?                 @relation("QuestionCreatedBy", fields: [createdById], references: [id])
  publishedBy    User?                 @relation("QuestionPublishedBy", fields: [publishedById], references: [id])
  reports        QuestionReport[]
  translations   QuestionTranslation[]
  versions       QuestionVersion[]
  sectionLinks   SectionQuestion[]
}

model QuestionTranslation {
  id               String   @id @default(uuid())
  questionId       String
  language         String
  statement        String
  options          Json
  correctOptionIds Json
  solution         String?
  question         Question @relation(fields: [questionId], references: [id])

  @@unique([questionId, language])
}

model SectionQuestion {
  id                    String   @id @default(uuid())
  sectionId             String
  questionId            String
  order                 Int      @default(0)
  marksOverride         Float?
  negativeMarksOverride Float?
  reviewStatus          String   @default("PENDING")
  question              Question @relation(fields: [questionId], references: [id])
  section               Section  @relation(fields: [sectionId], references: [id])
}

model Attempt {
  id             String             @id @default(uuid())
  testId         String?
  studentId      String
  status         AttemptStatus      @default(IN_PROGRESS)
  startedAt      DateTime           @default(now())
  submittedAt    DateTime?
  score          Float?
  rank           Int?
  integrityScore Int                @default(100)
  dppId          String?
  dpp            Dpp?               @relation(fields: [dppId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  student        User               @relation(fields: [studentId], references: [id])
  test           Test?              @relation(fields: [testId], references: [id], onDelete: Restrict)
  answers        AttemptAnswer[]
  violations     AttemptViolation[]

  @@unique([testId, studentId])
  @@unique([dppId, studentId])
}

model AttemptAnswer {
  id                String   @id @default(uuid())
  attemptId         String
  questionId        String
  selectedOptionIds Json     @default("[]")
  isCorrect         Boolean?
  timeTakenSec      Int      @default(0)
  updatedAt         DateTime @updatedAt
  attempt           Attempt  @relation(fields: [attemptId], references: [id])
  question          Question @relation(fields: [questionId], references: [id])

  @@unique([attemptId, questionId])
}

model AttemptViolation {
  id        String   @id @default(uuid())
  attemptId String
  type      String
  timestamp DateTime @default(now())
  attempt   Attempt  @relation(fields: [attemptId], references: [id])
}

model RankTrendPoint {
  id           String   @id @default(uuid())
  category     String
  marks        Int
  expectedRank Int
  year         Int      @default(2026)
  createdAt    DateTime @default(now())
  confidence   String?
  source       String?

  @@unique([category, marks, year])
}

model CollegeAllotment {
  id                String   @id @default(uuid())
  year              Int
  round             String   @default("Round 1")
  rank              Int
  quota             String
  instituteName     String
  course            String
  allottedCategory  String
  candidateCategory String
  remarks           String?
  createdAt         DateTime @default(now())

  @@index([year, rank])
  @@index([year, course, allottedCategory])
}

model DeviceSession {
  id            String    @id @default(uuid())
  userId        String
  deviceHash    String
  deviceType    String
  browser       String?
  os            String?
  timezone      String?
  screenRes     String?
  ipAddress     String?
  createdAt     DateTime  @default(now())
  revokedAt     DateTime?
  revokedReason String?
  user          User      @relation(fields: [userId], references: [id])
}

model SecurityConfig {
  id     String @id @default("singleton")
  policy String @default("SINGLE_SESSION")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  action     String
  entityType String?
  entityId   String?
  details    String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
}

model Bookmark {
  id         String   @id @default(uuid())
  studentId  String
  questionId String
  createdAt  DateTime @default(now())
  question   Question @relation(fields: [questionId], references: [id])
  student    User     @relation(fields: [studentId], references: [id])

  @@unique([studentId, questionId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model QuestionVersion {
  id            String   @id @default(uuid())
  questionId    String
  versionNumber Int
  editedById    String
  editedAt      DateTime @default(now())
  reason        String?
  changeType    String   @default("EDIT")
  snapshot      Json
  editedBy      User     @relation("QuestionVersionEditedBy", fields: [editedById], references: [id])
  question      Question @relation(fields: [questionId], references: [id])

  @@unique([questionId, versionNumber])
}

model QuestionReport {
  id            String    @id @default(uuid())
  questionId    String
  testId        String?
  reasonTags    String
  comment       String?
  screenshotUrl String?
  priority      String    @default("MEDIUM")
  status        String    @default("NEW")
  reportedById  String
  claimedById   String?
  claimedAt     DateTime?
  teacherNotes  String?
  createdAt     DateTime  @default(now())
  resolvedAt    DateTime?
  claimedBy     User?     @relation("ReportClaimedBy", fields: [claimedById], references: [id])
  question      Question  @relation(fields: [questionId], references: [id])
  reportedBy    User      @relation("ReportFiledBy", fields: [reportedById], references: [id])
}

model TestTemplate {
  id          String                @id @default(uuid())
  name        String
  description String?
  createdById String?
  createdAt   DateTime              @default(now())
  createdBy   User?                 @relation("TestTemplateCreatedBy", fields: [createdById], references: [id])
  sections    TestTemplateSection[]
}

model TestTemplateSection {
  id               String       @id @default(uuid())
  templateId       String
  name             String
  subject          String
  targetCount      Int
  marksPerQuestion Float?
  negativeMarks    Float?
  order            Int          @default(0)
  template         TestTemplate @relation(fields: [templateId], references: [id])
}

model Dpp {
  id                     String        @id @default(uuid())
  code                   String        @unique
  name                   String
  subject                String
  chapter                String
  facultyName            String?
  difficulty             String        @default("MEDIUM")
  languageMode           LanguageMode  @default(BOTH)
  description            String?
  tags                   String?
  instructions           String?
  estimatedTimeMin       Int           @default(30)
  correctMarks           Float         @default(4)
  incorrectMarks         Float         @default(-1)
  negativeMarkingEnabled Boolean       @default(true)
  questionTargetCount    Int           @default(0)
  status                 String        @default("DRAFT")
  createdById            String?
  createdAt              DateTime      @default(now())
  level                  Int?
  topics                 String[]      @default([])
  attempts               Attempt[]
  createdBy              User?         @relation("DppCreatedBy", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  questions              DppQuestion[]
}

model DppQuestion {
  id         String   @id @default(uuid())
  dppId      String
  questionId String
  order      Int      @default(0)
  dpp        Dpp      @relation(fields: [dppId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  question   Question @relation(fields: [questionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

enum Role {
  SUPER_ADMIN
  SUB_ADMIN
  TEACHER
  STUDENT
}

enum TestStatus {
  DRAFT
  PENDING_APPROVAL
  PUBLISHED
  UNDER_REVIEW
  APPROVED
}

enum LanguageMode {
  HINDI
  ENGLISH
  BOTH
}

enum QuestionType {
  SINGLE_CORRECT
  MULTIPLE_CORRECT
  INTEGER
  NUMERICAL
  STATEMENT_BASED
  MATCH_COLUMN
  ASSERTION_REASON
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  AUTO_SUBMITTED
}
